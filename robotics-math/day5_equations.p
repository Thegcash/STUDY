# Two-step equations: undo in reverse order

t1 = (1.7 - 0.5) / 2      # 2t + 0.5 = 1.7
x2 = (11 + 4) / 3         # 3x - 4 = 11
x3 = (3 - 2) / 0.5        # 0.5x + 2 = 3
a4 = (3.2 - 1.2) / 4      # 4a + 1.2 = 3.2
x5 = (5 - 2) * 4          # x/4 + 2 = 5
y6 = (5 - 1) / 2          # 5 - 2y = 1
v7 = 4.5 / 1.5            # 1.5v = 4.5
t8 = (0.9 - 0.1) / 0.2    # 0.2t + 0.1 = 0.9

print(t1, x2, x3, a4, x5, y6, v7, t8)
